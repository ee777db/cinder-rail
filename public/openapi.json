{
  "openapi": "3.1.0",
  "info": {
    "title": "Cinder native testnet API",
    "version": "0.2.0",
    "description": "Own CINDER asset and finite WORK entitlement. No cash value, USD peg, independent consensus or proof of correct LLM inference. Signatures ML-DSA-65; hashes SHA-384; UTF-8 canonical JSON sorts object keys and rejects unsafe integers. Full strict action schemas and SDK examples are in /developers. The prior P-256 sandbox is separately documented at /openapi-legacy.json."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "externalDocs": {
    "url": "https://cinder-rail.ee777db.workers.dev/developers"
  },
  "paths": {
    "/api/native/info": {
      "get": {
        "summary": "Network, finite supply, prices, quotas and operator key",
        "responses": {
          "200": {
            "description": "Success; native responses are no-store JSON except media."
          },
          "400": {
            "description": "Strict schema or input rejected"
          },
          "401": {
            "description": "Authorization failed"
          },
          "409": {
            "description": "Conflicting nonce, sequence or immutable data"
          },
          "429": {
            "description": "Testnet quota or finite capacity exhausted"
          }
        }
      }
    },

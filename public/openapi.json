  "components": {
    "schemas": {
      "Atoms": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$",
        "description": "Integer atoms: 1 CINDER = 1000000 atoms. No dollar price."
      },
      "Address": {
        "type": "string",
        "pattern": "^cin1[a-f0-9]{96}$"
      },
      "Digest": {
        "type": "string",
        "pattern": "^[a-f0-9]{96}$"
      },
      "Signature": {
        "type": "string",
        "description": "Canonical unpadded base64url ML-DSA-65 signature of canonical UTF-8 JSON."
      },
      "Transaction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "chainId",
          "sender",
          "nonce",
          "validUntil",
          "maxDebitAtoms",
          "actions"
        ],
        "properties": {
          "domain": {
            "const": "cinder.transaction.v1"
          },
          "chainId": {
            "const": "cinder-devnet-1"
          },
          "sender": {
            "$ref": "#/components/schemas/Address"
          },
          "nonce": {
            "type": "integer",
            "minimum": 1,
            "description": "Exactly current account nonce + 1."
          },
          "validUntil": {
            "type": "string",
            "format": "date-time",
            "description": "Canonical ISO timestamp, strictly future and no more than five minutes away."
          },
          "maxDebitAtoms": {
            "$ref": "#/components/schemas/Atoms"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Faucet"
                },
                {
                  "$ref": "#/components/schemas/Transfer"
                },
                {
                  "$ref": "#/components/schemas/Split"
                },
                {
                  "$ref": "#/components/schemas/Compute"
                },
                {
                  "$ref": "#/components/schemas/MusicPublish"
                },
                {
                  "$ref": "#/components/schemas/MusicListen"
                },
                {
                  "$ref": "#/components/schemas/MusicUnpublish"
                },
                {
                  "$ref": "#/components/schemas/WorkBuy"
                },
                {
                  "$ref": "#/components/schemas/WorkTransfer"
                },
                {
                  "$ref": "#/components/schemas/WorkRedeem"
                },
                {
                  "$ref": "#/components/schemas/AddLiquidity"
                },
                {
                  "$ref": "#/components/schemas/RemoveLiquidity"
                },
                {
                  "$ref": "#/components/schemas/Swap"
                },
                {
                  "$ref": "#/components/schemas/ChannelOpen"
                },
                {
                  "$ref": "#/components/schemas/ChannelClose"
                }
              ]
            },
            "description": "Strict per-action fields are documented in /developers. Music/economy/channel transactions contain exactly one action; base transfers/splits allow batches."
          }
        }
      },
      "Submit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transaction",
          "signature"
        ],
        "properties": {
          "transaction": {
            "$ref": "#/components/schemas/Transaction"
          },
          "signature": {
            "$ref": "#/components/schemas/Signature"
          },
          "computeInput": {
            "type": "string",
            "description": "Raw input matching the signed SHA-384 inputHash; only compute and economy.redeem."
          }
        }
      },
      "AccountRegistration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publicKey",
          "proof"
        ],
        "properties": {
          "publicKey": {
            "type": "string",
            "description": "Unpadded base64url ML-DSA-65 public key, 1952 raw bytes."
          },
          "proof": {
            "$ref": "#/components/schemas/Signature"
          }
        },
        "description": "Sign {domain: cinder.account.v1, chainId: cinder-devnet-1, publicKey}."
      },
      "SignedAuthorization": {
        "type": "object",
        "required": [
          "authorization",
          "signature"
        ],
        "properties": {
          "authorization": {
            "type": "object"
          },
          "signature": {
            "$ref": "#/components/schemas/Signature"
          }
        },
        "description": "Domain-separated strict fields differ by endpoint; use the SDK and linked developer guide."
      },
      "ChannelCall": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "signature",
          "input"
        ],
        "properties": {
          "message": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "chainId",
              "channelId",
              "sequence",
              "inputHash"
            ],
            "properties": {
              "domain": {
                "const": "cinder.channel-call.v1"
              },
              "chainId": {
                "const": "cinder-devnet-1"
              },
              "channelId": {
                "$ref": "#/components/schemas/Digest"
              },
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "inputHash": {
                "$ref": "#/components/schemas/Digest"
              }
            }
          },
          "signature": {
            "$ref": "#/components/schemas/Signature"
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "Faucet": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "faucet"
          }
        }
      },
      "Transfer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "to",
          "amountAtoms"
        ],
        "properties": {
          "type": {
            "const": "transfer"
          },
          "to": {
            "$ref": "#/components/schemas/Address"
          },
          "amountAtoms": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      },
      "Split": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "app",
          "amountAtoms",
          "recipients",
          "referenceHash",
          "units"
        ],
        "properties": {
          "type": {
            "const": "split"
          },
          "app": {
            "enum": [
              "music",
              "agent",
              "trade"
            ]
          },
          "amountAtoms": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address",
                "bps"
              ],
              "properties": {
                "address": {
                  "$ref": "#/components/schemas/Address"
                },
                "bps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              }
            },
            "description": "Unique registered recipients; integer basis points must sum to 10000."
          },
          "referenceHash": {
            "$ref": "#/components/schemas/Digest"
          },
          "units": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        }
      },
      "Compute": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "service",
          "inputHash"
        ],
        "properties": {
          "type": {
            "const": "compute"
          },
          "service": {
            "enum": [
              "hash",
              "inference"
            ]
          },
          "inputHash": {
            "$ref": "#/components/schemas/Digest"
          }
        }
      },
      "MusicPublish": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "audioHash",
          "title",
          "artist",
          "mime",
          "bytes",
          "recipients",
          "priceAtoms",
          "rightsDeclared"
        ],
        "properties": {
          "type": {
            "const": "music.publish"
          },
          "audioHash": {
            "$ref": "#/components/schemas/Digest"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "artist": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "mime": {
            "enum": [
              "audio/mpeg",
              "audio/wav",
              "audio/ogg"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 12,
            "maximum": 4194304
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address",
                "bps"
              ],
              "properties": {
                "address": {
                  "$ref": "#/components/schemas/Address"
                },
                "bps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              }
            },
            "description": "Unique registered recipients; integer basis points must sum to 10000."
          },
          "priceAtoms": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "rightsDeclared": {
            "const": true
          }
        }
      },
      "MusicListen": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "trackId",
          "listenId"
        ],
        "properties": {
          "type": {
            "const": "music.listen"
          },
          "trackId": {
            "$ref": "#/components/schemas/Digest"
          },
          "listenId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        }
      },
      "MusicUnpublish": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "trackId"
        ],
        "properties": {
          "type": {
            "const": "music.unpublish"
          },
          "trackId": {
            "$ref": "#/components/schemas/Digest"
          }
        }
      },
      "WorkBuy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "workUnits",
          "maxCinderAtoms"
        ],
        "properties": {
          "type": {
            "const": "economy.buy"
          },
          "workUnits": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "maxCinderAtoms": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      },
      "WorkTransfer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "to",
          "workUnits"
        ],
        "properties": {
          "type": {
            "const": "economy.transfer"
          },
          "to": {
            "$ref": "#/components/schemas/Address"
          },
          "workUnits": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      },
      "WorkRedeem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "inputHash"
        ],
        "properties": {
          "type": {
            "const": "economy.redeem"
          },
          "inputHash": {
            "$ref": "#/components/schemas/Digest"
          }
        }
      },
      "AddLiquidity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "maxCinderAtoms",
          "maxWorkUnits",
          "minLpUnits",
          "deadline"
        ],
        "properties": {
          "type": {
            "const": "economy.addLiquidity"
          },
          "maxCinderAtoms": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "maxWorkUnits": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "minLpUnits": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RemoveLiquidity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "lpUnits",
          "minCinderAtoms",
          "minWorkUnits",
          "deadline"
        ],
        "properties": {
          "type": {
            "const": "economy.removeLiquidity"
          },
          "lpUnits": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "minCinderAtoms": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "minWorkUnits": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Swap": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "assetIn",
          "amountIn",
          "minOut",
          "deadline"
        ],
        "properties": {
          "type": {
            "const": "economy.swap"
          },
          "assetIn": {
            "enum": [
              "CINDER",
              "WORK"
            ]
          },
          "amountIn": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "minOut": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ChannelOpen": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "sessionPublicKey",
          "capacity",
          "expiresAt",
          "service"
        ],
        "properties": {
          "type": {
            "const": "channel.open"
          },
          "sessionPublicKey": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "service": {
            "const": "hash"
          }
        }
      },
      "ChannelClose": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "channelId"
        ],
        "properties": {
          "type": {
            "const": "channel.close"
          },
          "channelId": {
            "$ref": "#/components/schemas/Digest"
          }
        }
      },
      "MediaUpload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authorization",
          "signature",
          "data"
        ],
        "properties": {
          "authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "chainId",
              "owner",
              "uploadId",
              "audioHash",
              "mime",
              "bytes",
              "chunks",
              "index",
              "chunkHash",
              "validUntil"
            ],
            "properties": {
              "domain": {
                "const": "cinder.media-chunk.v1"
              },
              "chainId": {
                "const": "cinder-devnet-1"
              },
              "owner": {
                "$ref": "#/components/schemas/Address"
              },
              "uploadId": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              "audioHash": {
                "$ref": "#/components/schemas/Digest"
              },
              "mime": {
                "enum": [
                  "audio/mpeg",
                  "audio/wav",
                  "audio/ogg"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 12,
                "maximum": 4194304
              },
              "chunks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 171
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 170
              },
              "chunkHash": {
                "$ref": "#/components/schemas/Digest"
              },
              "validUntil": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "signature": {
            "$ref": "#/components/schemas/Signature"
          },
          "data": {
            "type": "string",
            "description": "Unpadded base64url of exactly 24576 raw bytes, except the final chunk."
          }
        }
      },
      "MusicAccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authorization",
          "signature"
        ],
        "properties": {
          "authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "chainId",
              "owner",
              "transactionHash",
              "nonce",
              "validUntil"
            ],
            "properties": {
              "domain": {
                "const": "cinder.music.playback.v1"
              },
              "chainId": {
                "const": "cinder-devnet-1"
              },
              "owner": {
                "$ref": "#/components/schemas/Address"
              },
              "transactionHash": {
                "$ref": "#/components/schemas/Digest"
              },
              "nonce": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              "validUntil": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "signature": {
            "$ref": "#/components/schemas/Signature"
          }
        }
      }
    }
  }
}

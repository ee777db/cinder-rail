{
  "name": "cinder-rail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Budgeted machine compute with independently checkable signed receipts",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "node --test tests/protocol.test.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "check": "tsc --noEmit",
    "build": "node scripts/build-docs.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/build-docs.mjs && wrangler deploy",
    "test:contracts": "node scripts/test-contracts.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "^6.15.0",
    "ganache": "^7.9.2",
    "marked": "^15.0.12",
    "solc": "0.8.30",
    "typescript": "^5.9.2",
    "wrangler": "^4.40.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

{
  "name": "cinder-rail",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Native post-quantum authorized payments for agent work, creator access and resource exchange",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "check": "tsc --noEmit",
    "build": "node scripts/build-native.mjs && node scripts/build-docs.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/build-native.mjs && node scripts/build-docs.mjs && wrangler deploy",
    "test:contracts": "node scripts/test-contracts.mjs",
    "test:public": "node scripts/check-public.mjs",
    "test:apps": "node scripts/native-apps-smoke.mjs",
    "test:audit": "node scripts/audit-native.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "^6.15.0",
    "ganache": "^7.9.2",
    "marked": "^15.0.12",
    "solc": "0.8.30",
    "typescript": "^5.9.2",
    "wrangler": "^4.40.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1"
  }
}
